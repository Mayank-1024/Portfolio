# ---- OS / editor junk ----
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Large source files that should never ship ----
*.psd
*.ai
*.fig
*.sketch
*.mov
*.mp4
# small web clips the site plays (keep each under ~2 MB)
!assets/images/*.mp4
*.zip

# ---- Local tooling (Claude Code, Vercel) ----
.claude/settings.local.json
.claude/settings.json
.vercel

# ---- Dependencies / build output (if ever added) ----
node_modules/
dist/
build/
.cache/
*.log

# Sync-conflict duplicates (iCloud/Dropbox), never commit these
* 2
* 2.*
